{
  "manifest_version": 3,
  "name": "RobFlow Session Clipper",
  "version": "2.0.1",
  "description": "Auto-captures the RobFlow session + Cognito token and opens the viewer with one click (no DevTools copy).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RobFlow Session Clipper",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://api.robco.studio/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://robco.studio/cloud-robflow*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "RobFlow Session Clipper",
  "version": "3.1.0",
  "key": "",
  "description": "Hands the signed-in RobCo Studio session to the robot viewer: no page refresh, no copy/paste, no token in the URL.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RobFlow Session Clipper",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://api.robco.studio/*",
    "https://robco.studio/*",
    "https://*.web.app/*",
    "http://localhost:3000/*", "http://localhost:4173/*",
    "http://127.0.0.1:3000/*", "http://127.0.0.1:4173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://robco.studio/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.web.app/*",
        "http://localhost:3000/*", "http://localhost:4173/*",
        "http://127.0.0.1:3000/*", "http://127.0.0.1:4173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}

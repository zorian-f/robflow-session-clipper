{
  "manifest_version": 3,
  "name": "RobFlow Session Clipper",
  "version": "1.0.0",
  "description": "Auto-copies the RobFlow virtual robot session URL to your clipboard.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RobFlow Session Clipper",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://robco.studio/cloud-robflow*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
